#!/usr/bin/env bash
# Fast pre-commit validation for aidev-clis.
#
# Runs the meaningful-but-quick subset of `make check`: format, vet, build,
# isolation guards, and the (Go-cached) test suite. It deliberately SKIPS the
# 3-OS crossbuild — that belongs in `make check` / CI, not on every commit.
#
# Enable once:   make hooks       (sets core.hooksPath to scripts/githooks)
# Bypass once:   git commit --no-verify
set -euo pipefail

# Run from the repo root regardless of where git invoked us.
cd "$(git rev-parse --show-toplevel)"

step() { printf '\033[1m▶ %s\033[0m\n' "$1"; }
fail() { printf '\033[31m✗ %s\033[0m\n' "$1" >&2; exit 1; }

step "gofmt"
unformatted=$(gofmt -l .)
[ -z "$unformatted" ] || fail "gofmt needed:
$unformatted
fix: gofmt -w ."

step "go vet"
go vet ./... || fail "go vet failed"

step "go build"
go build ./... || fail "go build failed"

step "isolation guards"
bash scripts/check-isolation.sh || fail "isolation contract violated"

step "go test"
go test ./... || fail "tests failed"

printf '\033[32m✓ pre-commit checks passed\033[0m\n'
